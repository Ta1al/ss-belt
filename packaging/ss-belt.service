[Unit]
Description=ss-belt capture daemon (hotkeys, tray, socket)
Documentation=man:ss-belt(1)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY|DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/ss-belt daemon
ExecReload=/usr/bin/ss-belt daemon reload
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
